# Postgres connection. Dev default matches scripts/dev-db.mjs (embedded postgres).
# On GCP: point at Cloud SQL (postgres) instance.
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5502/isocodelabs

# Payload secret — generate a long random string for production.
PAYLOAD_SECRET=CHANGE_ME

# Public origin of the site (used for SEO, OG urls, sitemap).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Resend — founder notification emails on new contact/quiz/application
# submissions (src/lib/notify.ts). Without this set, notifications are
# silently skipped (the submission itself still saves fine either way).
# Sign up at resend.com, create an API key, and verify isocodelabs.com as a
# sending domain there (adds a few DNS records) before RESEND_FROM_EMAIL below
# will actually deliver.
RESEND_API_KEY=
# Must be on a domain verified in Resend. Defaults to this if unset.
RESEND_FROM_EMAIL=Isocode Notifications <notifications@isocodelabs.com>

# ── Careers hiring cycle v2 (see docs/careers-runbook.md) ─────────────────────
# Public careers origin. Set in production so links point at the subdomain;
# leave empty locally (links fall back to /careers/...).
NEXT_PUBLIC_CAREERS_URL=
# Applications are filed under this cycle; one application per email+role+cycle.
CAREERS_CYCLE=2026-10
# 'gcs' in production. 'local' (dev only) stores CVs under .local/storage.
CAREERS_STORAGE=local
# Private GCS bucket in asia-south1 for CVs (scripts/careers-gcs-setup.ts).
CAREERS_GCS_BUCKET=
# HMAC key for upload tickets — long random string (falls back to PAYLOAD_SECRET).
CAREERS_SIGNING_SECRET=
# Cloudflare Turnstile (Cloudflare dashboard → Turnstile → add site, managed mode).
# Leave empty locally to skip the check. For staging/load tests Cloudflare's
# published always-pass test keys work: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Per-IP limits per 10 minutes (generous: campus hostels share IPs).
CAREERS_RL_UPLOAD=40
CAREERS_RL_SUBMIT=20
# Only for load tests from a single machine.
CAREERS_RL_DISABLED=false
# Bearer secret Cloud Scheduler sends to POST /api/careers/cron/digest.
CAREERS_CRON_SECRET=
# Postgres pool size per Cloud Run instance (× max instances ≤ Cloud SQL max_connections).
DB_POOL_MAX=10
